+
+        private static EndpointExampleSet Receive() => new EndpointExampleSetBuilder()
+            .Request("knownWayFullyReceived", "Every card on a Known-way line received cleanly.",
+                new
+                {
+                    items = new object[]
+                    {
+                        new
+                        {
+                            productId = 15,
+                            realQuantityReceived = 2,
