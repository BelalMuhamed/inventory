+
+        private static EndpointExampleSet GetAll() => new EndpointExampleSetBuilder()
+            .Response(200, "page", "First page of tenants, default page size.",
+                new
+                {
+                    success = true,
+                    data = new
+                    {
+                        data = new[] { SampleTenant, SampleDeletedTenant },
