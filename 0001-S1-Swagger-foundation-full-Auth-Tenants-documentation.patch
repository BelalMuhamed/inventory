+
+        private static EndpointExampleSet GetById() => new EndpointExampleSetBuilder()
+            .Response(200, "found", "An active tenant.", new
+            {
+                success = true,
+                data = SampleTenant,
+                error = (object?)null
+            })
+            .Response(404, "notFound", "No tenant exists with that id.",
