+                [new EndpointKey("TenantsController", "ChangePassword")] = ChangePassword(),
+                [new EndpointKey("TenantsController", "SoftDelete")] = SoftDelete(),
+                [new EndpointKey("TenantsController", "Restore")] = Restore()
