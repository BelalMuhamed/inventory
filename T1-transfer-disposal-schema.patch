diff --git a/DomainLayer/Entities/CardDisposal.cs b/DomainLayer/Entities/CardDisposal.cs
new file mode 100644
index 0000000..eff7729
--- /dev/null
+++ b/DomainLayer/Entities/CardDisposal.cs
@@ -0,0 +1,85 @@
+using System;
+using System.Collections.Generic;
+using System.ComponentModel.DataAnnotations;
+
+namespace DomainLayer.Entities
+{
+    /// <summary>
+    /// A write-off: cards permanently removed from inventory, with the reason and the responsible
+    /// branch recorded (API §4.10, Addendum A).
+    /// <para>
+    /// <b>Why this is its own aggregate rather than columns on <c>ProductItem</c>.</b> A single
+    /// operational event ("a box arrived water-damaged") covers many cards. Storing the reason per
+    /// card would repeat it N times and give no way to ask "what did branch X write off last
+    /// quarter, and why" without scraping audit JSON. The header also gives §4.14 reporting a
+    /// natural place to hang off later.
+    /// </para>
+    /// <para>
+    /// Append-only, like transfers: no audit block, no soft delete, never updated after creation.
+    /// Disposal is the one operation in the system that destroys quantity, so it is deliberately
+    /// irreversible — a mistaken disposal is corrected by a compensating inbound batch, not by
+    /// undoing history.
+    /// </para>
+    /// </summary>
+    public class CardDisposal
+    {
+        /// <summary>Primary key (BIGINT IDENTITY).</summary>
+        [Key]
+        public long Id { get; set; }
+
+        /// <summary>Owning tenant id (FK → Tenants.Id).</summary>
+        public long TenantId { get; set; }
+
+        /// <summary>
+        /// Navigation to the owning tenant. Present so that this and
+        /// <see cref="DisposedByTenant"/> configure as two distinct relationships — EF Core
+        /// identifies a relationship by its navigations, so two navigation-less
+        /// <c>HasOne&lt;Tenant&gt;().WithMany()</c> calls would silently reconfigure the same one.
+        /// </summary>
+        public Tenant Tenant { get; set; } = null!;
+
+        /// <summary>
+        /// Branch that performed the disposal and whose stock was decremented (FK → Branches.Id).
+        /// <para>
+        /// Required, and supplied explicitly by the caller rather than derived: cards being
+        /// disposed mid-transfer have no branch of their own
+        /// (<c>ProductItem.BranchID IS NULL</c>), so there is nothing to derive it from.
+        /// </para>
+        /// </summary>
+        public long BranchId { get; set; }
+
+        /// <summary>Navigation to the disposing branch.</summary>
+        public Branch Branch { get; set; } = null!;
+
+        /// <summary>
+        /// The transfer this disposal settled (FK → CardsTransferHistory.Id), or <c>null</c> when
+        /// cards sitting at a branch were written off outside any transfer.
+        /// </summary>
+        public long? CardTransferId { get; set; }
+
+        /// <summary>Navigation to the settled transfer, or <c>null</c>.</summary>
+        public CardTransfer? CardTransfer { get; set; }
+
+        /// <summary>
+        /// Tenant that performed the disposal (FK → Tenants.Id). Non-nullable: a system admin may
+        /// never dispose cards, so there is always a tenant to record.
+        /// </summary>
+        public long DisposedByTenantId { get; set; }
+
+        /// <summary>Navigation to the disposing tenant.</summary>
+        public Tenant DisposedByTenant { get; set; } = null!;
+
+        /// <summary>UTC instant of the write-off.</summary>
+        public DateTime DisposedAt { get; set; }
+
+        /// <summary>
+        /// Why the cards were written off. Mandatory and non-empty — an unexplained write-off is
+        /// indistinguishable from stock going missing, which is exactly what this record exists to
+        /// rule out.
+        /// </summary>
+        public string Reason { get; set; } = null!;
+
+        /// <summary>The cards written off. At least one always exists.</summary>
+        public List<CardDisposalItem> Items { get; set; } = new();
+    }
+}
diff --git a/DomainLayer/Entities/CardDisposalItem.cs b/DomainLayer/Entities/CardDisposalItem.cs
new file mode 100644
index 0000000..8efdb37
--- /dev/null
+++ b/DomainLayer/Entities/CardDisposalItem.cs
@@ -0,0 +1,35 @@
+using System.ComponentModel.DataAnnotations;
+
+namespace DomainLayer.Entities
+{
+    /// <summary>
+    /// One card written off under a <see cref="CardDisposal"/> (API §4.10, Addendum A).
+    /// <para>
+    /// Rows exist for every disposal regardless of the product's transaction way. Unknown-way
+    /// disposal still names the specific cards it consumed — the caller does not choose them
+    /// (the system takes them FIFO), but the record of which cards left inventory is exact either
+    /// way. Without that, a disposal would reduce a quantity with nothing to reconcile against.
+    /// </para>
+    /// </summary>
+    public class CardDisposalItem
+    {
+        /// <summary>Primary key (BIGINT IDENTITY).</summary>
+        [Key]
+        public long Id { get; set; }
+
+        /// <summary>Owning tenant id (FK → Tenants.Id). Denormalized from the parent for scoping.</summary>
+        public long TenantId { get; set; }
+
+        /// <summary>Owning disposal id (FK → CardDisposals.Id, cascade).</summary>
+        public long CardDisposalId { get; set; }
+
+        /// <summary>Navigation to the owning disposal.</summary>
+        public CardDisposal CardDisposal { get; set; } = null!;
+
+        /// <summary>The card written off (FK → ProductItems.Id). Unique per disposal.</summary>
+        public long ProductItemId { get; set; }
+
+        /// <summary>Navigation to the card.</summary>
+        public ProductItem ProductItem { get; set; } = null!;
+    }
+}
diff --git a/DomainLayer/Entities/CardTransfer.cs b/DomainLayer/Entities/CardTransfer.cs
new file mode 100644
index 0000000..fe3214d
--- /dev/null
+++ b/DomainLayer/Entities/CardTransfer.cs
@@ -0,0 +1,143 @@
+using DomainLayer.Enums;
+using System;
+using System.Collections.Generic;
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+
+namespace DomainLayer.Entities
+{
+    /// <summary>
+    /// A movement of cards from one branch to another (ERD §4.3, table
+    /// <c>CardsTransferHistory</c>; API §4.10).
+    /// <para>
+    /// <b>Append-only.</b> Deliberately does <em>not</em> derive from <c>AuditableEntity</c>: per
+    /// ERD §6.5 a transfer is immutable except for <see cref="TransactionStatus"/> and
+    /// <see cref="StatusChangedAt"/>, is never soft-deleted, and has no restore endpoint. It
+    /// therefore carries its own <see cref="CreatedAt"/> rather than inheriting the audit block,
+    /// and it is not picked up by the <c>AuditSaveChangesInterceptor</c> — the service layer logs
+    /// its non-CRUD actions explicitly through <c>IAuditLogger</c>.
+    /// </para>
+    /// <para>
+    /// <b>Two ways a transfer is born.</b> A tenant user creates one directly
+    /// (<see cref="TransactionOrigin.UserCreated"/>, <see cref="BranchRequestId"/> null), or the
+    /// system manufactures one to carry the unreceived remainder of a partial receipt back to its
+    /// source (<see cref="TransactionOrigin.AutoGeneratedReturn"/>,
+    /// <see cref="ParentTransferId"/> set).
+    /// </para>
+    /// <para>
+    /// <b>Settlement.</b> There is no refuse endpoint. Every outcome flows through <c>receive</c>,
+    /// which carries a disposition per product line: received, disposed, or (implicitly) returned.
+    /// </para>
+    /// </summary>
+    public class CardTransfer
+    {
+        /// <summary>Primary key (BIGINT IDENTITY).</summary>
+        [Key]
+        public long Id { get; set; }
+
+        /// <summary>Owning tenant id (FK → Tenants.Id).</summary>
+        public long TenantId { get; set; }
+
+        /// <summary>
+        /// Navigation to the owning tenant. Present so that this and
+        /// <see cref="CreatedByTenant"/> configure as two distinct relationships — EF Core
+        /// identifies a relationship by its navigations, so two navigation-less
+        /// <c>HasOne&lt;Tenant&gt;().WithMany()</c> calls would silently reconfigure the same one
+        /// and leave the second foreign key unmapped.
+        /// </summary>
+        public Tenant Tenant { get; set; } = null!;
+
+        /// <summary>
+        /// The branch request this transfer fulfils (API §4.9), or <c>null</c> for a direct
+        /// transfer. Always <c>null</c> today.
+        /// <para>
+        /// <b>Deliberately declared without a foreign key or navigation property</b> (decision Q2):
+        /// the <c>BranchRequests</c> table does not exist yet. The column is provisioned now so
+        /// that §4.9 only has to add the constraint — no data migration, no DTO churn, and the
+        /// list filter can be wired today and simply match nothing.
+        /// </para>
+        /// </summary>
+        public long? BranchRequestId { get; set; }
+
+        /// <summary>UTC instant the transfer was created and dispatched.</summary>
+        public DateTime CreatedAt { get; set; }
+
+        /// <summary>
+        /// Tenant that created the transfer (FK → Tenants.Id). Non-nullable, which is the
+        /// structural reason a system admin cannot create a transfer (decision Q7) — an admin
+        /// token carries no tenant id to put here.
+        /// </summary>
+        public long CreatedByTenantId { get; set; }
+
+        /// <summary>Navigation to the creating tenant.</summary>
+        public Tenant CreatedByTenant { get; set; } = null!;
+
+        /// <summary>Branch the cards left (FK → Branches.Id).</summary>
+        public long SourceBranchId { get; set; }
+
+        /// <summary>Navigation to the source branch.</summary>
+        public Branch SourceBranch { get; set; } = null!;
+
+        /// <summary>Branch the cards are headed to (FK → Branches.Id). Never equal to the source.</summary>
+        public long TargetBranchId { get; set; }
+
+        /// <summary>Navigation to the target branch.</summary>
+        public Branch TargetBranch { get; set; } = null!;
+
+        /// <summary>Lifecycle state. Only <see cref="Enums.TransactionStatus.InProgress"/> is non-terminal.</summary>
+        /// <remarks>
+        /// The property intentionally shares its name with its type, matching the ERD §4.3 column
+        /// name. The initializer is fully qualified so the compiler is never asked to disambiguate.
+        /// </remarks>
+        public TransactionStatus TransactionStatus { get; set; } = Enums.TransactionStatus.InProgress;
+
+        /// <summary>UTC instant the status last changed, or <c>null</c> while still in progress.</summary>
+        public DateTime? StatusChangedAt { get; set; }
+
+        /// <summary>
+        /// Free-text note captured at settlement — the disposal reason, or a receiving remark.
+        /// <para>
+        /// <b>Schema note:</b> not in ERD §4.3; added with decision Q8 (approved). ERD §4.1 already
+        /// models the equivalent on branch requests. Flagged for DBA review.
+        /// </para>
+        /// </summary>
+        public string? ActionNotes { get; set; }
+
+        /// <summary>Whether a person raised this transfer or the system manufactured it.</summary>
+        public TransactionOrigin Origin { get; set; } = TransactionOrigin.UserCreated;
+
+        /// <summary>
+        /// The transfer whose partial receipt produced this one (self-FK → CardsTransferHistory.Id),
+        /// or <c>null</c> for an ordinary transfer.
+        /// <para>
+        /// Chains are capped at one level by construction: a return is settled by receive-or-dispose
+        /// and never spawns a further return, so <c>Parent.Parent</c> is always <c>null</c>.
+        /// </para>
+        /// </summary>
+        public long? ParentTransferId { get; set; }
+
+        /// <summary>Navigation to the parent transfer, or <c>null</c>.</summary>
+        public CardTransfer? ParentTransfer { get; set; }
+
+        /// <summary>
+        /// Optimistic-concurrency token guarding the status flip.
+        /// <para>
+        /// <b>Schema note:</b> not in ERD §4.3; added with decision Q8 (approved). Without it two
+        /// concurrent receive calls can both read <see cref="Enums.TransactionStatus.InProgress"/>
+        /// and both move stock — a status re-read inside the transaction narrows that window but
+        /// does not close it.
+        /// </para>
+        /// </summary>
+        [Timestamp]
+        public byte[] RowVersion { get; set; } = null!;
+
+        /// <summary>Product lines carried by this transfer. At least one always exists.</summary>
+        public List<CardTransferProduct> Products { get; set; } = new();
+
+        /// <summary>
+        /// Individually tracked cards. Populated only for Known-way product lines; an Unknown-way
+        /// transfer carries quantities and no item rows at all.
+        /// </summary>
+        public List<CardTransferItem> Items { get; set; } = new();
+    }
+}
diff --git a/DomainLayer/Entities/CardTransferItem.cs b/DomainLayer/Entities/CardTransferItem.cs
new file mode 100644
index 0000000..bc3d322
--- /dev/null
+++ b/DomainLayer/Entities/CardTransferItem.cs
@@ -0,0 +1,45 @@
+using DomainLayer.Enums;
+using System.ComponentModel.DataAnnotations;
+
+namespace DomainLayer.Entities
+{
+    /// <summary>
+    /// One individually tracked card on a Known-way transfer (ERD §4.5, table
+    /// <c>CardTransferItems</c>).
+    /// <para>
+    /// Written only for lines whose snapshotted <see cref="ProductTransactionWay"/> is
+    /// <see cref="ProductTransactionWay.Known"/>. An Unknown-way line moves quantities against the
+    /// stock aggregate and produces no rows here — that is the whole difference between the two
+    /// ways at the data level.
+    /// </para>
+    /// <para>
+    /// A card returned by a partial receipt gets a <em>fresh</em> row on the auto-generated return
+    /// transfer; this row stays as the historical record of the outbound leg, marked
+    /// <see cref="TransactionItemReceiveStatus.NotReceived"/>.
+    /// </para>
+    /// </summary>
+    public class CardTransferItem
+    {
+        /// <summary>Primary key (BIGINT IDENTITY).</summary>
+        [Key]
+        public long Id { get; set; }
+
+        /// <summary>Owning tenant id (FK → Tenants.Id). Denormalized from the parent for scoping.</summary>
+        public long TenantId { get; set; }
+
+        /// <summary>Owning transfer id (FK → CardsTransferHistory.Id, cascade).</summary>
+        public long CardTransferId { get; set; }
+
+        /// <summary>Navigation to the owning transfer.</summary>
+        public CardTransfer CardTransfer { get; set; } = null!;
+
+        /// <summary>The card being moved (FK → ProductItems.Id). Unique per transfer.</summary>
+        public long ProductItemId { get; set; }
+
+        /// <summary>Navigation to the card.</summary>
+        public ProductItem ProductItem { get; set; } = null!;
+
+        /// <summary>Per-card outcome. Starts <see cref="TransactionItemReceiveStatus.Pending"/>.</summary>
+        public TransactionItemReceiveStatus ReceiveStatus { get; set; } = TransactionItemReceiveStatus.Pending;
+    }
+}
diff --git a/DomainLayer/Entities/CardTransferProduct.cs b/DomainLayer/Entities/CardTransferProduct.cs
new file mode 100644
index 0000000..9051cf3
--- /dev/null
+++ b/DomainLayer/Entities/CardTransferProduct.cs
@@ -0,0 +1,67 @@
+using DomainLayer.Enums;
+using System.ComponentModel.DataAnnotations;
+
+namespace DomainLayer.Entities
+{
+    /// <summary>
+    /// One product line on a transfer (ERD §4.4, table <c>CardTransferProducts</c>): how many of
+    /// a given product were sent, and how the target settled them.
+    /// <para>
+    /// Append-only alongside its parent (ERD §6.5) — no audit block, no soft delete.
+    /// </para>
+    /// </summary>
+    public class CardTransferProduct
+    {
+        /// <summary>Primary key (BIGINT IDENTITY).</summary>
+        [Key]
+        public long Id { get; set; }
+
+        /// <summary>Owning tenant id (FK → Tenants.Id). Denormalized from the parent for scoping.</summary>
+        public long TenantId { get; set; }
+
+        /// <summary>Owning transfer id (FK → CardsTransferHistory.Id, cascade).</summary>
+        public long CardTransferId { get; set; }
+
+        /// <summary>Navigation to the owning transfer.</summary>
+        public CardTransfer CardTransfer { get; set; } = null!;
+
+        /// <summary>Product id (FK → Products.Id). Unique per transfer.</summary>
+        public long ProductId { get; set; }
+
+        /// <summary>Navigation to the product.</summary>
+        public Product Product { get; set; } = null!;
+
+        /// <summary>Quantity dispatched from the source branch. Always greater than zero.</summary>
+        public int TransactedQuantity { get; set; }
+
+        /// <summary>Quantity accepted at the target, or <c>null</c> until the transfer is settled.</summary>
+        public int? RealQuantityReceived { get; set; }
+
+        /// <summary>
+        /// Quantity written off at the target instead of being accepted or returned (Addendum A),
+        /// or <c>null</c> until settled.
+        /// <para>
+        /// The returned remainder is deliberately <em>not</em> stored: it is
+        /// <c>TransactedQuantity − RealQuantityReceived − DisposedQuantity</c>, and duplicating a
+        /// derivable value invites the two to disagree. The database enforces that the three
+        /// quantities stay consistent.
+        /// </para>
+        /// <para>
+        /// <b>Schema note:</b> not in ERD §4.4; added with Addendum A (approved).
+        /// </para>
+        /// </summary>
+        public int? DisposedQuantity { get; set; }
+
+        /// <summary>
+        /// How this product's cards are tracked, snapshotted from
+        /// <see cref="Product.ProductTransactionWay"/> when the transfer was created (ERD §4.4).
+        /// <para>
+        /// Settlement reads this, never the live product. Product-level immutability (decision P6)
+        /// already prevents the value drifting once cards exist, so the snapshot is a second line
+        /// of defence rather than the only one — but an in-flight transfer must be settled the way
+        /// it was dispatched regardless of anything that happens to the catalog meanwhile.
+        /// </para>
+        /// </summary>
+        public ProductTransactionWay ProductTransactionWay { get; set; }
+    }
+}
diff --git a/DomainLayer/Enums/TransactionItemReceiveStatus.cs b/DomainLayer/Enums/TransactionItemReceiveStatus.cs
new file mode 100644
index 0000000..a843b3d
--- /dev/null
+++ b/DomainLayer/Enums/TransactionItemReceiveStatus.cs
@@ -0,0 +1,33 @@
+namespace DomainLayer.Enums
+{
+    /// <summary>
+    /// Per-card outcome inside a Known-way transfer (ERD §8, extended by Addendum A). Persisted
+    /// as <c>TINYINT</c>. Only meaningful for products whose snapshotted
+    /// <see cref="ProductTransactionWay"/> is <see cref="ProductTransactionWay.Known"/> — an
+    /// Unknown-way line moves quantities and writes no item rows at all.
+    /// </summary>
+    public enum TransactionItemReceiveStatus : byte
+    {
+        /// <summary>In flight; the target has not settled this card yet. ERD value 0.</summary>
+        Pending = 0,
+
+        /// <summary>Received at the target branch; the card is now pinned there. ERD value 1.</summary>
+        Received = 1,
+
+        /// <summary>
+        /// Not received. The card is going back to the source under the auto-generated return
+        /// transfer, where it gets a fresh item row of its own. ERD value 2.
+        /// </summary>
+        NotReceived = 2,
+
+        /// <summary>
+        /// Written off at the target instead of being received or returned (Addendum A). The card
+        /// moves to <see cref="CardStatus.Disposed"/> and leaves inventory; a
+        /// <c>CardDisposal</c> record carries the mandatory reason.
+        /// <para>
+        /// <b>Schema note:</b> not in the original ERD §8 list; added with Addendum A (approved).
+        /// </para>
+        /// </summary>
+        Disposed = 3
+    }
+}
diff --git a/DomainLayer/Enums/TransactionOrigin.cs b/DomainLayer/Enums/TransactionOrigin.cs
new file mode 100644
index 0000000..4e22ee2
--- /dev/null
+++ b/DomainLayer/Enums/TransactionOrigin.cs
@@ -0,0 +1,28 @@
+namespace DomainLayer.Enums
+{
+    /// <summary>
+    /// Whether a transfer was raised by a person or manufactured by the system (API §4.10,
+    /// decision Q5). Persisted as <c>TINYINT</c>.
+    /// <para>
+    /// The distinction is not cosmetic: an auto-generated return exists only because a person
+    /// declined part of a shipment, so reporting that counts "transfers created" would double-count
+    /// the same operational event without this flag, and a UI that lists returns alongside
+    /// outbound shipments would read as noise.
+    /// </para>
+    /// <para>
+    /// <b>Schema note:</b> not in the ERD; added with decision Q5 (approved).
+    /// </para>
+    /// </summary>
+    public enum TransactionOrigin : byte
+    {
+        /// <summary>Raised directly by a tenant user, or (later) by confirming a branch request.</summary>
+        UserCreated = 0,
+
+        /// <summary>
+        /// Manufactured by the system to carry the unreceived remainder of a partially received
+        /// transfer back to its source. Follows the ordinary lifecycle: the source branch must
+        /// explicitly receive or dispose it.
+        /// </summary>
+        AutoGeneratedReturn = 1
+    }
+}
diff --git a/DomainLayer/Enums/TransactionStatus.cs b/DomainLayer/Enums/TransactionStatus.cs
new file mode 100644
index 0000000..c9dec96
--- /dev/null
+++ b/DomainLayer/Enums/TransactionStatus.cs
@@ -0,0 +1,58 @@
+namespace DomainLayer.Enums
+{
+    /// <summary>
+    /// Lifecycle state of a card transfer (ERD §8, extended by API §4.10 decisions Q5 and
+    /// Addendum A). Persisted as <c>TINYINT</c>.
+    /// <para>
+    /// <see cref="InProgress"/> is the only non-terminal value. Every other value closes the
+    /// transfer permanently — a remainder that still has to move continues its life in a
+    /// separate, auto-generated return transfer rather than reopening this one.
+    /// </para>
+    /// </summary>
+    public enum TransactionStatus : byte
+    {
+        /// <summary>
+        /// Created and dispatched; the quantity sits in the source branch's hold and the cards
+        /// have left that branch (<c>BranchID IS NULL</c>). ERD value 0.
+        /// </summary>
+        InProgress = 0,
+
+        /// <summary>Every transacted card was received at the target. ERD value 1.</summary>
+        Received = 1,
+
+        /// <summary>
+        /// Nothing was received and nothing was disposed: the whole quantity is going back, under
+        /// an auto-generated return transfer. ERD value 2.
+        /// <para>
+        /// Reachable only through <c>receive</c> with zero received and zero disposed — the
+        /// separate <c>refuse</c> endpoint was removed in favour of the disposition model, so this
+        /// is now the "rejected in full" outcome rather than a distinct workflow.
+        /// </para>
+        /// </summary>
+        ReturnedBack = 2,
+
+        /// <summary>
+        /// Some cards were received and/or disposed at the target, and the rest (if any) moved to
+        /// an auto-generated return transfer. Terminal for <em>this</em> transfer.
+        /// <para>
+        /// <b>Schema note:</b> not in the original ERD §8 list; added with decision Q5 (approved).
+        /// Appended as 3 so the ERD's own 0/1/2 keep their meaning.
+        /// </para>
+        /// <para>
+        /// Per-product "FullyReceived / PartialReceived" remains a query-time DTO computation over
+        /// <c>TransactedQuantity</c> vs <c>RealQuantityReceived</c> (ERD §4.5) — never a column.
+        /// </para>
+        /// </summary>
+        PartiallyReceived = 3,
+
+        /// <summary>
+        /// The whole remaining quantity was written off by the holding party instead of being
+        /// received or returned (Addendum A). Terminal, and the outcome that stops a return leg
+        /// from bouncing between two branches indefinitely.
+        /// <para>
+        /// <b>Schema note:</b> not in the original ERD §8 list; added with Addendum A (approved).
+        /// </para>
+        /// </summary>
+        Disposed = 4
+    }
+}
