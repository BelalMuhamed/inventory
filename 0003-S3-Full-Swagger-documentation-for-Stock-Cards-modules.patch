+            Merge(catalog, ProductItemExamples.Build());
+            Merge(catalog, InventoryExamples.Build());
+            Merge(catalog, InventoryHistoryExamples.Build());
+            Merge(catalog, CardFileExamples.Build());
+
             return catalog;
         }
 
